{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "nix *": "allow",
      "nixos-rebuild *": "allow",
      "sudo nixos-rebuild *": "allow",
      "rebuild": "allow",
      "just *": "allow",
      "nix-shell *": "allow",
      "nix-env *": "allow",
      "nix search *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "git log *": "allow",
      "git stash *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git diff *": "allow",
      "git status": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "wc *": "allow",
      "hostname": "allow",
      "whoami": "allow",
      "*": "ask"
    }
  }
}
